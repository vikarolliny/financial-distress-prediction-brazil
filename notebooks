['ID']=pd.to_numeric(df['ID'],errors='raise').astype('int64')\n","        df['LABEL']=pd.to_numeric(df['LABEL'],errors='raise').astype('int64')\n","        if not df['LABEL'].isin([0,1]).all(): raise ValueError(f'{nome}: LABEL não-binário')\n","    indicadores=[f'A{i}' for i in range(1,85)]\n","    for nome, df in [('Original',original),('Painel',painel),('Modelagem',alvo)]:\n","        ausentes=set(indicadores)-set(df.columns)\n","        if ausentes: raise ValueError(f'{nome}: indicadores ausentes {sorted(ausentes)}')\n","    for nome, df in [('Original', original),('Painel',painel),('Modelagem',alvo)]:\n","        if df.duplicated(['ID','QUARTER']).any():\n","            raise ValueError(f'{nome}: ID + QUARTER duplicado, rever antes de prosseguir')\n","\n","    orig_q = original.copy()\n","    orig_q['TRIMESTRE_CALENDARIO']=orig_q['QUARTER'].dt.to_period('Q').astype(str)\n","    dup_trimestre=orig_q[orig_q.duplicated(['ID','TRIMESTRE_CALENDARIO'],keep=False)][['ID','QUARTER','TRIMESTRE_CALENDARIO','LABEL']].sort_values(['ID','QUARTER'])\n","    dup_trimestre.to_csv(destino/'observacoes_repetidas_trimestre.csv',index=False)\n","    fora_fim=orig_q.loc[~orig_q['QUARTER'].dt.is_quarter_end,['ID','QUARTER','LABEL']].copy()\n","    fora_fim.to_csv(destino/'datas_fora_fim_trimestre.csv',index=False)\n","\n","    # Comparação por chave, sem supor que a ordenação das linhas é igual.\n","    col=['ID','QUARTER','LABEL']+indicadores\n","    comum=original[col].merge(painel[col],on=['ID','QUARTER'],how='outer',indicator=True,validate='one_to_one',suffixes=('_orig','_painel'))\n","    retiradas=comum.loc[comum['_merge'].eq('left_only'),['ID','QUARTER','LABEL_orig']].rename(columns={'LABEL_orig':'LABEL'}).copy()\n","    retiradas.to_csv(destino/'linhas_removidas_na_limpeza.csv',index=False)\n","    iguais=comum['_merge'].eq('both')\n","    alterados={}\n","    for c in ['LABEL']+indicadores:\n","        a=pd.to_numeric(comum.loc[iguais,c+'_orig'],errors='coerce').to_numpy(dtype=float)\n","        b=pd.to_numeric(comum.loc[iguais,c+'_painel'],errors='coerce').to_numpy(dtype=float)\n","        n=int(np.count_nonzero(~np.isclose(a,b,rtol=1e-10,atol=1e-10,equal_nan=True)))\n","        if n: alterados[c]=n\n","    # Eventos observados na base original e persistência\n","    ordenado=painel.sort_values(['ID','QUARTER']).copy()\n","    ordenado['LABEL_ANTERIOR']=ordenado.groupby('ID')['LABEL'].shift(1)\n","    transicoes=pd.crosstab(ordenado['LABEL_ANTERIOR'],ordenado['LABEL'],dropna=False)\n","    transicoes.to_csv(destino/'transicoes_label.csv')\n","    primeira=ordenado.groupby('ID',sort=True).first()[['LABEL']].rename(columns={'LABEL':'LABEL_NA_ENTRADA'})\n","    empresas_pos=ordenado.loc[ordenado.LABEL.eq(1),'ID'].nunique()\n","    eventos_0_1=int(((ordenado.LABEL_ANTERIOR==0)&(ordenado.LABEL==1)).sum())\n","    eventos_1_0=int(((ordenado.LABEL_ANTERIOR==1)&(ordenado.LABEL==0)).sum())\n","    eventos_no_inicio=int(primeira.LABEL_NA_ENTRADA.eq(1).sum())\n","    eventos=ordenado.loc[ordenado.LABEL.eq(1)].groupby('ID')['QUARTER'].min().rename('PRIMEIRO_LABEL_1')\n","    eventos.to_csv(destino/'datas_primeiro_label_1.csv')\n","\n","    # Reconstituir TARGET_DISTRESS_12M pelas mesmas regras documentadas\n","    # na etapa 03: 365 dias e gaps de no máximo 120 dias.\n","    previstos=[]\n","    for id_, g in ordenado.groupby('ID',sort=False):\n","        datas=g['QUARTER'].to_numpy(dtype='datetime64[ns]')\n","        labs=g['LABEL'].to_numpy(dtype=int)\n","        pos=np.flatnonzero(labs==1)\n","        evento=int(pos[0]) if len(pos) else None\n","        for i in np.flatnonzero(labs==0):\n","            t=datas[i]\n","            dias_ate_evento=(int((datas[evento]-t)/np.timedelta64(1,'D')) if evento is not None else None)\n","            if dias_ate_evento is not None and dias_ate_evento<=0:\n","                continue\n","            if dias_ate_evento is not None and dias_ate_evento<=365:\n","                j=evento\n","                gaps=np.diff(datas[i:j+1]).astype('timedelta64[D]').astype(int)\n","                if len(gaps)==0 or gaps.max()<=120:\n","                    previstos.append((id_,pd.Timestamp(t),1))\n","            else:\n","                j=int(np.searchsorted(datas,t+np.timedelta64(365,'D'),side='left'))\n","                if j<len(datas):\n","                    gaps=np.diff(datas[i:j+1]).astype('timedelta64[D]').astype(int)\n","                    if len(gaps)==0 or gaps.max()<=120:\n","                        previstos.append((id_,pd.Timestamp(t),0))\n","    recalculado=pd.DataFrame(previstos,columns=['ID','QUARTER','TARGET_RECALCULADO'])\n","    original_alvo=alvo[['ID','QUARTER','LABEL','TARGET_DISTRESS_12M']].copy()\n","    original_alvo['TARGET_DISTRESS_12M']=pd.to_numeric(original_alvo['TARGET_DISTRESS_12M'],errors='raise').astype(int)\n","    confronto=original_alvo.merge(recalculado,on=['ID','QUARTER'],how='outer',indicator=True,validate='one_to_one')\n","    divergencias=confronto.loc[~confronto['_merge'].eq('both')|(confronto['TARGET_DISTRESS_12M']!=confronto['TARGET_RECALCULADO'])]\n","    divergencias.to_csv(destino/'divergencias_alvo_12m.csv',index=False)\n","\n","    stats={\n","        'observacoes_base_original':len(original),\n","        'empresas_originais':original.ID.nunique(),\n","        'positivos_label_original':int(original.LABEL.sum()),\n","        'negativos_label_original':int(original.LABEL.eq(0).sum()),\n","        'observacoes_painel':len(painel),\n","        'observacoes_removidas':int(comum['_merge'].eq('left_only').sum()),\n","        'observacoes_acrescentadas':int(comum['_merge'].eq('right_only').sum()),\n","        'celulas_alteradas_nas_linhas_preservadas':sum(alterados.values()),\n","        'linhas_com_data_nao_fim_trimestre_original':len(fora_fim),\n","        'pares_repetidos_no_mesmo_trimestre_calendario_original':len(dup_trimestre)//2,\n","        'empresas_com_label_1':empresas_pos,\n","        'transicoes_0_para_1':eventos_0_1,\n","        'transicoes_1_para_0':eventos_1_0,\n","        'empresas_que_ja_comecam_em_label_1':eventos_no_inicio,\n","        'linhas_modelagem':len(alvo),\n","        'positivos_target_12m':int(alvo.TARGET_DISTRESS_12M.sum()),\n","        'negativos_target_12m':int(alvo.TARGET_DISTRESS_12M.eq(0).sum()),\n","        'empresas_com_target_positivo':alvo.loc[alvo.TARGET_DISTRESS_12M.eq(1),'ID'].nunique(),\n","        'linhas_modelagem_com_label_original_diferente_de_zero':int((alvo.LABEL!=0).sum()),\n","        'linhas_alvo_recalculado':len(recalculado),\n","        'divergencias_target_12m':len(divergencias),\n","    }\n","    pd.DataFrame([{'verificacao':k,'valor':v} for k,v in stats.items()]).to_csv(destino/'resumo_conferencia.csv',index=False)\n","    with open(destino/'LEIA_ME.txt','w',encoding='utf-8') as f:\n","        f.write('AUDITORIA REPRODUZÍVEL — CVM\\n\\n')\n","        f.write('Fonte: Rubens Marques Chaves, Nonstationary and Imbalanced Dataset for Financial Distress Prediction (2025).\\n')\n","        f.write('GitHub: https://github.com/rubensmchaves/ml-fdp\\nIEEE DataPort: https://doi.org/10.21227/x8ry-gz76\\n\\n')\n","        f.write('O autor descreve LABEL=0 como normal e LABEL=1 como financial distress.\\n')\n","        f.write('A regra operacional completa de criação de LABEL não está explícita no README.\\n')\n","        f.write('TARGET_DISTRESS_12M é um alvo DERIVADO no projeto, prevendo LABEL=1 futuro nos 365 dias seguintes.\\n')\n","        f.write('Essas verificações testam integridade e correspondência de dados, NÃO validam a definição econômica do LABEL, nem excluem vazamento por regra de rotulagem ou datas de publicação.\\n\\n')\n","        for k,v in stats.items(): f.write(f'{k}: {v}\\n')\n","        if alterados: f.write('Indicadores alterados: '+repr(alterados)+'\\n')\n","    pacote=destino.parent/'auditoria_CVM_conferencia_reproduzivel.zip'\n","    with zipfile.ZipFile(pacote,'w',compression=zipfile.ZIP_DEFLATED) as z:\n","        for file in sorted(destino.iterdir()):\n","            if file.is_file(): z.write(file,arcname=file.name)\n","    print('\\nRESULTADO DA CONFERÊNCIA')\n","    for k,v in stats.items(): print(f'{k}: {v}')\n","    print('\\nPacote de resultados:',pacote)\n","    return stats, pacote\n","\n"],"metadata":{"id":"xuCyzNcjXPIw"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["resultado, pacote = auditar(zip_original, limpo, modelagem)\n","\n","# Interromper se houver qualquer diferença substantiva entre bases.\n","assert resultado[\"observacoes_acrescentadas\"] == 0, \"Painel adicionou linhas que não estavam no original.\"\n","assert resultado[\"celulas_alteradas_nas_linhas_preservadas\"] == 0, \"Houve alteração de valores no painel.\"\n","assert resultado[\"divergencias_target_12m\"] == 0, \"O TARGET_DISTRESS_12M não corresponde às regras implementadas.\"\n","assert resultado[\"linhas_modelagem_com_label_original_diferente_de_zero\"] == 0, \"Há pontos de partida com LABEL original diferente de zero.\"\n","\n","print(\"\\nCONFERÊNCIA CONCLUÍDA: as verificações acima passaram.\")\n","from google.colab import files\n","files.download(str(pacote))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":498},"id":"966CJhoVXNFE","executionInfo":{"status":"ok","timestamp":1792970425469,"user_tz":180,"elapsed":7558,"user":{"displayName":"Vitória Karolliny","userId":"04902831398934237780"}},"outputId":"25df91f2-9696-406e-dab5-50b2bb9eb2c5"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","RESULTADO DA CONFERÊNCIA\n","observacoes_base_original: 32005\n","empresas_originais: 1004\n","positivos_label_original: 884\n","negativos_label_original: 31121\n","observacoes_painel: 31999\n","observacoes_removidas: 6\n","observacoes_acrescentadas: 0\n","celulas_alteradas_nas_linhas_preservadas: 0\n","linhas_com_data_nao_fim_trimestre_original: 40\n","pares_repetidos_no_mesmo_trimestre_calendario_original: 6\n","empresas_com_label_