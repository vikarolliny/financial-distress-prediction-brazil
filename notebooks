   \"column\": \"positivos_teste\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 10,\n        \"min\": 20,\n        \"max\": 38,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          38,\n          20\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"empresas_positivas_teste\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 8,\n        \"min\": 8,\n        \"max\": 23,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          9,\n          8\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"ultima_data_treino\",\n      \"properties\": {\n        \"dtype\": \"object\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"2015-12-31\",\n          \"2017-12-31\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"data_limite_horizonte_rotulo_treino\",\n      \"properties\": {\n        \"dtype\": \"object\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"2016-12-30\",\n          \"2018-12-31\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"primeira_data_teste\",\n      \"properties\": {\n        \"dtype\": \"object\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"2017-02-28\",\n          \"2019-02-28\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"dias_de_folga_apos_horizonte\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0,\n        \"min\": 59,\n        \"max\": 60,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          59,\n          60\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"horizonte_treino_nao_alcanca_teste\",\n      \"properties\": {\n        \"dtype\": \"boolean\",\n        \"num_unique_values\": 1,\n        \"samples\": [\n          true\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"mesmas_empresas_podem_aparecer_nos_dois\",\n      \"properties\": {\n        \"dtype\": \"boolean\",\n        \"num_unique_values\": 1,\n        \"samples\": [\n          true\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Nenhum horizonte de 365 dias de um exemplo de TREINO alcança as datas de TESTE desses folds.\n","Isto não prova ausência de vazamento pela data real de publicação das demonstrações,\n","nem permite inferir como o autor original construiu LABEL.\n"]}]},{"cell_type":"code","source":["# ROBUSTEZ DESCRITIVA POR EPISÓDIO PAREADO\n","necessarias = ['episodio','empresa','grupo','lag_trimestres','A39','A38','A42','A76']\n","faltam = [c for c in necessarias if c not in traj.columns]\n","if faltam:\n","    raise ValueError('Colunas ausentes no ZIP de trajetórias: ' + str(faltam))\n","\n","traj['episodio']=traj['episodio'].astype(str)\n","traj['empresa']=traj['empresa'].astype(str)\n","traj['lag_trimestres']=pd.to_numeric(traj['lag_trimestres'], errors='raise').astype(int)\n","indicadores=['A39','A38','A42','A76']\n","for c in indicadores:\n","    traj[c]=pd.to_numeric(traj[c], errors='coerce').replace([np.inf, -np.inf], np.nan)\n","\n","contagens = (traj.groupby(['episodio','grupo','lag_trimestres']).size()\n","              .unstack('lag_trimestres', fill_value=0))\n","if traj['episodio'].nunique() != 47:\n","    print('AVISO: quantidade de episódios diferente de 47:', traj['episodio'].nunique())\n","if not set([1,4]).issubset(traj['lag_trimestres'].unique()):\n","    raise ValueError('Faltam períodos -4 ou -1 para a comparação.')\n","\n","linhas=[]\n","for ep, parte in traj.groupby('episodio'):\n","    for col in indicadores:\n","        # Nível do episódio no trimestre -1, usando mediana dos 3 controles\n","        ev_m1 = parte[(parte['grupo']=='Com evento') & (parte['lag_trimestres']==1)][col]\n","        co_m1 = parte[(parte['grupo']=='Controle') & (parte['lag_trimestres']==1)][col]\n","        # Mudança individual entre -4 e -1 antes de resumir controles\n","        pvt = (parte[parte['lag_trimestres'].isin([1,4])]\n","               .pivot_table(index=['grupo','empresa'], columns='lag_trimestres',\n","                            values=col, aggfunc='first'))\n","        if not set([1,4]).issubset(pvt.columns):\n","            continue\n","        pvt['delta_m4_m1'] = pvt[1]-pvt[4]\n","        try:\n","            ev_delta = pvt.xs('Com evento', level='grupo')['delta_m4_m1'].median()\n","            co_delta = pvt.xs('Controle', level='grupo')['delta_m4_m1'].median()\n","        except KeyError:\n","            continue\n","        if ev_m1.empty or co_m1.empty:\n","            continue\n","        linhas.append({\n","            'episodio': ep,\n","            'indicador': col,\n","            'evento_nivel_m1':ev_m1.median(),\n","            'controle_mediana_nivel_m1':co_m1.median(),\n","            'diferenca_nivel_m1': ev_m1.median()-co_m1.median(),\n","            'evento_delta_m4_m1':ev_delta,\n","            'controle_mediana_delta_m4_m1':co_delta,\n","            'diferenca_delta_m4_m1':ev_delta-co_delta,\n","        })\n","comparacoes = pd.DataFrame(linhas)\n","if comparacoes.empty:\n","    raise ValueError('Nenhuma comparação pareada pôde ser construída.')\n","\n","# Bootstrap NÃO paramétrico por episódio. Mesmos controles podem ser reutilizados\n","# entre episódios, de modo que estes intervalos são exploratórios.\n","rng = np.random.default_rng(42)\n","B=3000\n","\n","def bootstrap_mediana(v):\n","    v=np.asarray(v,dtype=float)\n","    v=v[np.isfinite(v)]\n","    if len(v)<5:\n","        return (np.nan,np.nan)\n","    idx=rng.integers(0,len(v),size=(B,len(v)))\n","    meds=np.median(v[idx],axis=1)\n","    return tuple(np.quantile(meds,[.025,.975]))\n","\n","res=[]\n","for col,parte in comparacoes.groupby('indicador',sort=False):\n","    dv=parte['diferenca_nivel_m1'].dropna().to_numpy()\n","    dc=parte['diferenca_delta_m4_m1'].dropna().to_numpy()\n","    lo1,hi1=bootstrap_mediana(dv)\n","    lo2,hi2=bootstrap_mediana(dc)\n","    res.append({\n","        'indicador':col,\n","        'episodios_validos_nivel':len(dv),\n","        'mediana_diferenca_nivel_m1':np.median(dv),\n","        'IC95_exploratorio_nivel_inf':lo1,\n","        'IC95_exploratorio_nivel_sup':hi1,\n","        'eventos_nivel_abaixo_controles':int(np.sum(dv<0)),\n","        'episodios_validos_variacao':len(dc),\n","        'mediana_diferenca_variacao_m4_m1':np.median(dc),\n","        'IC95_exploratorio_delta_inf':lo2,\n","        'IC95_exploratorio_delta_sup':hi2,\n","        'eventos_com_variacao_menor_que_controle':int(np.sum(dc<0)),\n","    })\n","res_robustez=pd.DataFrame(res).sort_values('indicador')\n","print('ROBUSTEZ DOS INDICADORES (diferenças = evento menos mediana dos controles do mesmo episódio)')\n","display(res_robustez)\n","print('Interpretação: diferença de NÍVEL negativa é menor valor no grupo evento;')\n","print('diferença de VARIAÇÃO negativa é maior queda / menor crescimento no grupo evento.')\n","print('Os intervalos bootstrap são exploratórios devido à reutilização de controles e à seleção retrospectiva.')\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":266},"id":"qeUvyImmaGP7","executionInfo":{"status":"ok","timestamp":1792971144000,"user_tz":180,"elapsed":2775,"user":{"displayName":"Vitória Karolliny","userId":"04902831398934237780"}},"outputId":"d21f5f22-b521-4db8-a51a-dc9c71e0cbde"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["ROBUSTEZ DOS INDICADORES (dif