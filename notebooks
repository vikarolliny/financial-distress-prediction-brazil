model\", RandomForestClassifier(n_estimators=400, min_samples_leaf=5,\n","                class_weight=\"balanced_subsample\", random_state=42, n_jobs=-1))\n","        ])\n","    }\n","\n","score_parts = []\n","fit_audit = []\n","for w in windows:\n","    train = df[df[\"QUARTER\"] <= w[\"train_end\"]].copy()\n","    test = df[df[\"QUARTER\"].between(w[\"test_start\"], w[\"test_end\"])].copy()\n","    train = train.dropna(subset=[\"TARGET_DISTRESS_12M\"])\n","    test = test.dropna(subset=[\"TARGET_DISTRESS_12M\"])\n","    # O treino precisa conter as duas classes; o teste precisa ter linhas.\n","    if len(test) == 0 or train[\"TARGET_DISTRESS_12M\"].nunique() < 2:\n","        print(\"Janela ignorada:\", w[\"janela\"], \"| treino:\", len(train), \"| teste:\", len(test))\n","        continue\n","    for name, model in models().items():\n","        y_train = train[\"TARGET_DISTRESS_12M\"].astype(int)\n","        model.fit(train[features], y_train)\n","        scores = model.predict_proba(test[features])[:, 1]\n","        part = test[[\"ID\",\"QUARTER\",\"TARGET_DISTRESS_12M\"] + indicators].copy()\n","        part[\"janela\"] = w[\"janela\"]\n","        part[\"modelo\"] = name\n","        part[\"score\"] = scores\n","        score_parts.append(part)\n","        fit_audit.append({\n","            \"janela\":w[\"janela\"], \"modelo\":name,\n","            \"treino_ate\":w[\"train_end\"].date(), \"teste_de\":w[\"test_start\"].date(),\n","            \"teste_ate\":w[\"test_end\"].date(), \"linhas_treino\":len(train),\n","            \"positivos_treino\":int(y_train.sum()), \"linhas_teste\":len(test),\n","            \"positivos_teste\":int(test[\"TARGET_DISTRESS_12M\"].sum()),\n","            \"empresas_teste\":test[\"ID\"].nunique()\n","        })\n","\n","predictions = pd.concat(score_parts, ignore_index=True) if score_parts else pd.DataFrame()\n","audit_df = pd.DataFrame(fit_audit)\n","display(audit_df)\n","if predictions.empty:\n","    raise ValueError(\"Nenhuma jane