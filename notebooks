\n","    (\"imputer\", SimpleImputer(strategy=\"median\")),\n","    (\"scaler\", RobustScaler()),\n","    (\"model\", LogisticRegression(\n","        C=0.1, class_weight=\"balanced\", solver=\"liblinear\",\n","        max_iter=5000, random_state=42\n","    )),\n","])\n","logistic.fit(X_train, y_train)\n","\n","random_forest = Pipeline([\n","    (\"imputer\", SimpleImputer(strategy=\"median\")),\n","    (\"model\", RandomForestClassifier(\n","        n_estimators=300, max_depth=4, min_samples_leaf=20,\n","        max_features=\"sqrt\", class_weight=\"balanced_subsample\",\n","        random_state=42, n_jobs=-1\n","    )),\n","])\n","random_forest.fit(X_train, y_train)\n","\n","scores = {\n","    \"Baseline sem ranking\": baseline.predict_proba(X_test)[:, 1],\n","    \"Regressão logística\": logistic.predict_proba(X_test)[:, 1],\n","    \"Random Forest\": random_forest.predict_proba(X_test)[:, 1],\n","}\n","print(\"Modelos treinados.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"n9eEPERj3GOh","executionInfo":{"status":"ok","timestamp":1792945425581,"user_tz":180,"elapsed":11831,"user":{"displayName":"Vitória Karolliny","userId":"04902831398934237780"}},"outputId":"4d73f2a5-56c6-45c5-b7eb-a9aea7b88461"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Modelos treinados.\n"]}]},{"cell_type":"code","source":["metric_rows = []\n","for model_name, score in scores.items():\n","    metric_rows.append({\n","        \"modelo\": model_name,\n","        \"average_precision_PR_AUC\": average_precision_score(y_test, score),\n","        \"ROC_AUC\": roc_auc_score(y_test, score),\n","        \"taxa_positiva_teste\": y_test.mean(),\n","    })\n","metrics_df = pd.DataFrame(metric_rows).sort_values(\"average_precision_PR_AUC\", ascending=False)\n","display(metrics_df.style.format({\n","    \"average_precision_PR_AUC\": \"{:.4f}\",\n","    \"ROC_AUC\": \"{:.4f}\",\n","    \"taxa_positiva_teste\": \"{:.3%}\",\n","}))\n","print(\"R