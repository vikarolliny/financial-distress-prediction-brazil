l_type":"code","source":["import os, zipfile\n","os.makedirs(\"resultados_etapa7\", exist_ok=True)\n","audit_df.to_csv(\"resultados_etapa7/auditoria_janelas.csv\", index=False)\n","predictions.to_csv(\"resultados_etapa7/predicoes_por_observacao.csv\", index=False)\n","company_scores.to_csv(\"resultados_etapa7/ranking_por_empresa.csv\", index=False)\n","company_topk.to_csv(\"resultados_etapa7/avaliacao_topk_por_empresa.csv\", index=False)\n","hist.to_csv(\"resultados_etapa7/historico_indicadores_antes_evento.csv\", index=False)\n","trajectory.to_csv(\"resultados_etapa7/resumo_trajetoria_indicadores.csv\")\n","zip_path = \"resultados_etapa7_ranking_empresa_trajetoria.zip\"\n","with zipfile.ZipFile(zip_path, \"w\", zipfile.ZIP_DEFLATED) as z:\n","    for filename in os.listdir(\"resultados_etapa7\"):\n","        z.write(os.path.join(\"resultados_etapa7\", filename), arcname=filename)\n","print(\"Arquivo gerado:\", zip_path)\n","files.download(zip_path)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":35},"id":"7A-XyfQzzFsU","executionInfo":{"status":"ok","timestamp":1792961682639,"user_tz":180,"elapsed":625,"user":{"displayName":"Vitória Karolliny","userId":"04902831398934237780"}},"outputId":"18757091-3ff2-4267-952d-11aa7f6d1ff7"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Arquivo gerado: resultados_etapa7_ranking_empresa_trajetoria.zip\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","    async function download(id, filename, size) {\n","      if (!google.colab.kernel.accessAllowed) {\n","        return;\n","      }\n","      const div = document.createElement('div');\n","      const label = document.createElement('label');\n","      label.textContent = `Downloading \"${filename}\": `;\n","      div.appendChild(label);\n","      const progress = document.createElement('progress');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","      // Send a message to notify the kernel that we're ready.\n","      channel.send({})\n","\n","      for await (const message of channel.messages) {\n","        // Send a message to notify the kernel that we're ready.\n","        channel.send({})\n","        if (message.buffers) {\n","          for (const buffer of message.buffers) {\n","            buffers.push(buffer);\n","            downloaded += buffer.byteLength;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_100df64c-c248-4516-a9e4-8b685f354bd1\", \"resultados_etapa7_ranking_empresa_trajetoria.zip\", 1231984)"]},"metadata":{}}]},{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from google.colab import files\n","\n","# 1. Carregar a base que preserva o LABEL original\n","uploaded = files.upload()\n","arquivo = next(\n","    (n for n in uploaded if n.endswith(\".csv\")),\n","    None\n",")\n","if arquivo is None:\n","    raise ValueError(\"Envie a base_cvm_painel_trimestral_sem_duplicatas.csv\")\n","\n","df = pd.read_csv(arquivo)\n","df[\"ID\"] = df[\"ID\"].astype(str)\n","df[\"QUARTER\"] = pd.to_datetime(df[\"QUARTER\"], errors=\"coerce\")\n","df[\"LABEL\"] = pd.to_numeric(df[\"LABEL\"], errors=\"coerce\")\n","df = df.dropna(subset=[\"ID\", \"QUARTER\", \"LABEL\"])\n","df = df.sort_values([\"ID\", \"QUARTER\"])\n","\n","# Indicadores priorizados nas etapas anteriores\n","indicators = [\n","    \"A39\", \"A57\", \"A61\", \"A76\",\n","    \"A38\", \"A42\", \"A69\", \"A78\"\n","]\n","indicators = [c for c in indicators if c in df.columns]\n","\n","# 2. Identificar a primeira ocorrência do LABEL=1\n","first_event = (\n","    df.loc[df[\"LABEL\"].eq(1)]\n","      .groupby(\"ID\")[\"QUARTER\"]\n","      .min()\n",")\n","\n","event_firms = set(first_event.index)\n","control_firms = set(df[\"ID\"].unique()) - event_firms\n","\n","print(\"Empresas com LABEL=1:\", len(event_firms))\n","print(\"Empresas sem LABEL=1 observado:\", len(control_firms))\n","print(\"Indicadores analisados:\", indicators)\n","\n","# 3. Criar índice para localizar empresa e trimestre\n","indexed = df.set_index([\"ID\", \"QUARTER\"]).sort_index()\n","records = []\n","\n","# Para cada empresa com evento, comparar com empresas\n","# sem LABEL=1 observado no mesmo trimestre-calendário.\n","for firm, event_date in first_event.items():\n","\n","    for lag in range(4, -1, -1):\n","        date = event_date - pd.DateOffset(months=3 * lag)\n","        key = (firm, date)\n","\n","        if key not in indexed.index:\n","            continue\n","\n","        row = indexed.loc[key]\n","        if isinstance(row, pd.DataFrame):\n","            row = row.iloc[0]\n","\n","        rec = {\n","            \"grupo\": \"Com evento\",\n","            \"ID\": firm,\n","            \"data_referencia\": event_date,\n","            \"lag_trimestres\": lag\n","        }\n","        rec.update({c: row[c] for c in indicators})\n","        records.append(rec)\n","\n","        # Controles: empresas sem LABEL=1 observado,\n","        # com observação no mesmo trimestre de referência.\n","        if lag == 0:\n","            for control in control_firms:\n","                control_key = (control, event_date)\n","\n","                if control_key not in indexed.index:\n","                    continue\n","\n","                control_row = indexed.loc[control_key]\n","                if isinstance(control_row, pd.DataFrame):\n","                    control_row = control_row.iloc[0]\n","\n","                if control_row[\"LABEL\"] != 0:\n","                    continue\n","\n","                for control_lag in range(4, -1, -1):\n","                    control_date = event_date - pd.DateOffset(\n","                        months=3 * control_lag\n","                    )\n","                    ckey = (control, control_date)\n","\n","                    if ckey not in indexed.index:\n","                        continue\n","\n","                    cr = indexed.loc[ckey]\n","                    if isinstance(cr, pd.DataFrame):\n","                        cr = cr.iloc[0]\n","\n","                    # Não usar observações com LABEL=1\n","                    if cr[\"LABEL\"] != 0:\n","                        continue\n","\n","                    crec = {\n","                        \"grupo\": \"Controle\",\n","                        \"ID\": control,\n","                        \"data_referencia\": event_date,\n","                        \"lag_trimestres\": control_lag\n","                    }\n","                    crec.update({c: cr[c] for c in indicators})\n","                    records.append(crec)\n","\n","traj = pd.DataFrame(records)\n","\n","if traj.empty:\n","    raise ValueError(\"Nenhuma trajetória válida foi construída.\")\n","\n","traj[\"janela\"] = traj[\"lag_trimestres\"].map({\n","    4: \"4 trimestres antes\",\n","    3: \"3 trimestres antes\",\n","    2: \"2 trimestres antes\",\n","    1: \"1 trimestre antes\",\n","    0: \"Trimestre de referência\"\n","})\n","\n","# 4. Resumo: contagem e mediana por grupo e janela\n","summary = (\n","    traj.groupby([\"grupo\", \"lag_trimestres\", \"janela\"])[indicators]\n","        .agg([\"count\", \"median\"])\n","        .reset_index()\n","        .sort_values([\"grupo\", \"lag_trimestres\"], ascending=[True, False])\n",")\n","\n","display(summary)\n","\n","# 5. Gráficos comparativos das medianas\n","order = [\n","    \"4 trimestres antes\",\n","    \"3 trimestres antes\",\n","    \"2 trimestres antes\",\n","    \"1 trimestre antes\",\n","    \"Trimestre de referência\"\n","]\n","\n","for col in indicators:\n","    plt.figure(figsize=(9, 4))\n","\n","    for group in [\"Com evento\", \"Controle\"]:\n","        part = traj[traj[\"grupo\"].eq(group)]\n","        med = part.groupby(\"janela\")[col].median().reindex(order)\n","        plt.plot(order, med.values, marker=\"o\", label=group)\n","\n","    plt.title(f\"Trajetória mediana — {col}\")\n","    plt.ylabel(\"Mediana do indicador\")\n","    plt.xticks(rotation=20, ha=\"right\")\n","    plt.legend()\n","    plt.tight_layout()\n","    plt.show()\n","\n","# 6. Exportar os resultados\n","traj.to_csv(\"trajetorias_evento_controle.csv\", index=False)\n","summary.to_csv(\"resumo_trajetoria_evento_controle.csv\", index=False)\n","\n","print(\"Arquivos gerados:\")\n","print(\"- trajetorias_evento_controle.csv\")\n","print(\"- resumo_trajetoria_evento_controle.csv\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"EtdOnHUK6l_s","executionInfo":{"status":"ok","timestamp":1792964587415,"user_tz":180,"elapsed":196387,"user":{"displayName":"Vitória Karolliny","userId":"04902831398934237780"}},"outputId":"638191cd-5480-4b98-e7ec-b711ec42358c"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-1682e32b-2502-4cd2-9375-abf17ec20543\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-1682e32b-2502-4cd2-9375-abf17ec20543\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n",