n","            if dias_evento is not None and dias_evento <= HORIZON_DAYS:\n","                gaps = np.diff(dates[i:primeiro_evento+1]).astype('timedelta64[D]').astype(int)\n","                target = 1 if (gaps.max() if len(gaps) else 0) <= MAX_GAP_DAYS else None\n","            else:\n","                limite = t + np.timedelta64(HORIZON_DAYS, 'D')\n","                fim = int(np.searchsorted(dates, limite, side='left'))\n","                if fim >= len(dates):\n","                    target = None\n","                else:\n","                    gaps = np.diff(dates[i:fim+1]).astype('timedelta64[D]').astype(int)\n","                    target = 0 if (gaps.max() if len(gaps) else 0) <= MAX_GAP_DAYS else None\n","\n","            if target is not None:\n","                registros.append({\n","                    'ID':id_,\n","                    'PERIODO':str(pd.Timestamp(t).to_period('Q')),\n","                    'TARGET_DISTRESS_12M':target\n","                })\n","    return pd.DataFrame(registros)\n","\n","alvo_reproduzido = recalcular_alvo(painel)\n","normalizado = painel.copy()\n","normalizado['QUARTER'] = (\n","    normalizado['QUARTER'].dt.to_period('Q').dt.to_timestamp(how='end').dt.normalize()\n",")\n","alvo_simulado = recalcular_alvo(normalizado)\n","\n","chaves = ['ID','PERIODO']\n","referencia = modelo[chaves + ['TARGET_DISTRESS_12M']].copy()\n","comparacao_original = referencia.merge(\n","    alvo_reproduzido, on=chaves, how='outer', indicator=True,\n","    suffixes=('_MODELO','_RECALCULADO'), validate='one_to_one'\n",")\n","assert comparacao_original['_merge'].eq('both').all()\n","assert comparacao_original['TARGET_DISTRESS_12M_MODELO'].eq(\n","    comparacao_original['TARGET_DISTRESS_12M_RECALCULADO']).all(),     'O alvo não foi reproduzido: revisar a base carregada.'\n","\n","comparacao = referencia.merge(\n","    alvo_simulado, on=chaves, how='outer', indicator=True,\n","    suffixes=('_ORIGINAL','_SIMULADO'), validate='one_to_one'\n"