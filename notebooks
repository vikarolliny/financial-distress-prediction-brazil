 dificuldade financeira da fonte, mas regra operacional exata não confirmada. O target de 12 meses foi construído pelo projeto e não equivale automaticamente a falência.\n","\n","**Zero:** a presença de zero pode ter origem econômica legítima ou codificação de ausências/denominadores nulos; não imputar zeros como ausentes sem evidência de definição.\n","'''\n","(saidas/'RELATORIO_E_LIMITACOES.md').write_text(relatorio,encoding='utf-8')\n","\n","zip_saida='etapa09_auditoria_temporal_robustez_CVM.zip'\n","with zipfile.ZipFile(zip_saida,'w',zipfile.ZIP_DEFLATED) as z:\n","    for p in sorted(saidas.iterdir()):\n","        z.write(p,arcname=p.name)\n","\n","print('AUDITORIA CONCLUÍDA — arquivo:',zip_saida)\n","files.download(zip_saida)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":35},"id":"6sbT9qQFaKqd","executionInfo":{"status":"ok","timestamp":1792971160282,"user_tz":180,"elapsed":60,"user":{"displayName":"Vitória Karolliny","userId":"04902831398934237780"}},"outputId":"ad2c368a-da9c-4492-9e9f-9785282757ce"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["AUDITORIA CONCLUÍDA — arquivo: etapa09_auditoria_temporal_robustez_CVM.zip\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","    async function download(id, filename, size) {\n","      if (!google.colab.kernel.accessAllowed) {\n","        return;\n","      }\n","      const div = document.createElement('div');\n","      const label = document.createElement('label');\n","      label.textContent = `Downloading \"${filename}\": `;\n","      div.appendChild(label);\n","      const progress = document.createElement('progress');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","     