s');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","      // Send a message to notify the kernel that we're ready.\n","      channel.send({})\n","\n","      for await (const message of channel.messages) {\n","        // Send a message to notify the kernel that we're ready.\n","        channel.send({})\n","        if (message.buffers) {\n","          for (const buffer of message.buffers) {\n","            buffers.push(buffer);\n","            downloaded += buffer.byteLength;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_61a29194-d842-463d-94b9-25333b4df02e\", \"trajetorias_evento_controle.csv\", 21387669)"]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Download iniciado: trajetorias_evento_controle.csv\n"]}]},{"cell_type":"code","source":["\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import os\n","import zipfile\n","from google.colab import files\n","from IPython.display import display\n","\n","# ============================================================\n","# ETAPA 1 — ENVIAR A BASE ORIGINAL\n","# ============================================================\n","print(\"ENVIE: base_cvm_painel_trimestral_sem_duplicatas.csv\")\n","uploaded = files.upload()\n","\n","if not uploaded:\n","    raise ValueError(\"Nenhum arquivo foi enviado.\")\n","\n","arquivo = next(\n","    (n for n in uploaded if n.lower().endswith(\".csv\")),\n","    None\n",")\n","\n","if arquivo is None:\n","    raise ValueError(\"O arquivo enviado precisa ser um CSV.\")\n","\n","df = pd.read_csv(arquivo)\n","df.columns = df.columns.astype(str).str.strip()\n","\n","# Validar a base correta antes de continuar\n","obrigatorias = [\"ID\", \"QUARTER\", \"LABEL\"]\n","faltantes = [c for c in obrigatorias if c not in df.columns]\n","\n","if faltantes:\n","    raise ValueError(\n","        f\"Este não parece ser a base original esperada. \"\n","        f\"Colunas ausentes: {faltantes}. \"\n","        f\"Envie base_cvm_painel_trimestral_sem_duplicatas.csv.\"\n","    )\n","\n","df[\"ID\"] = df[\"ID\"].astype(str).str.strip()\n","df[\"QUARTER\"] = pd.to_datetime(df[\"QUARTER\"], errors=\"coerce\")\n","df[\"LABEL\"] = pd.to_numeric(df[\"LABEL\"], errors=\"coerce\")\n","\n","df = df.dropna(subset=[\"ID\", \"QUARTER\", \"LABEL\"]).copy()\n","df = df[df[\"LABEL\"].isin([0, 1])].copy()\n","\n","indicadores = [\n","    \"A39\", \"A57\", \"A61\", \"A76\",\n","    \"A38\", \"A42\", \"A69\", \"A78\"\n","]\n","indicadores = [c for c in indicadores if c in df.columns]\n","\n","if not indicadores:\n","    raise ValueError(\"Nenhum dos indicadores A39, A57, A61, A76, A38, A42, A69 ou A78 foi encontrado.\")\n","\n","for c in indicadores:\n","    df[c] = pd.to_numeric(df[c], errors=\"coerce\")\n","\n","# Garantir uma única linha por empresa e trimestre.\n","# Se houver duplicatas conflitantes, interromper para evitar escolhas arbitrárias.\n","duplicatas = df.duplicated([\"ID\", \"QUARTER\"], keep=False)\n","\n","if duplicatas.any():\n","    conflitos = (\n","        df[duplicatas].groupby([\"ID\", \"QUARTER\"])[\"LABEL\"]\n","        .nunique()\n","    )\n","    if (conflitos > 1).any():\n","        raise ValueError(\n","            \"Há empresa/trimestre com LABEL conflitante. \"\n","            \"Não é seguro continuar sem resolver essas duplicatas.\"\n","        )\n","    df = df.drop_duplicates([\"ID\", \"QUARTER\"], keep=\"first\")\n","\n","df = df.sort_values([\"ID\", \"QUARTER\"])\n","\n","print(\"\\nBase carregada:\", arquivo)\n","print(\"Linhas:\", len(df))\n","print(\"Empresas:\", df[\"ID\"].nunique())\n","print(\"Indicadores:\", indicadores)\n","\n","# ============================================================\n","# ETAPA 2 — IDENTIFICAR A PRIMEIRA DATA DE LABEL=1\n","# ============================================================\n","eventos = (\n","    df.loc[df[\"LABEL\"].eq(1)]\n","      .groupby(\"ID\")[\"QUARTER\"]\n","      .min()\n","      .to_dict()\n",")\n","\n","print(\"Empresas com LABEL=1 observado:\", len(eventos))\n","\n","# Índice para localizar rapidamente uma observação\n","lookup = {\n","    (row[\"ID\"], row[\"QUARTER\"]): row\n","    for _, row in df.iterrows()\n","}\n","datas_empresa = df.groupby(\"ID\")[\"QUARTER\"].apply(set).to_dict()\n","empresas = list(datas_empresa.keys())\n","\n","rng = np.random.default_rng(42)\n","registros = []\n","auditoria = []\n","\n","# ============================================================\n","# ETAPA 3 — COMPARAÇÃO EQUILIBRADA\n","# Para cada empresa com evento:\n","# - exige os 5 trimestres (lags 4 a 0);\n","# - exige LABEL=0 nos 4 trimestres anteriores;\n","# - seleciona até 3 controles com a mesma data de referência;\n","# - exige LABEL=0 nos 5 trimestres dos controles.\n","# ============================================================\n","for empresa_evento, data_evento in eventos.items():\n","\n","    datas = {\n","        lag: data_evento - pd.DateOffset(months=3 * lag)\n","        for lag in range(5)\n","    }\n","\n","    if not all(\n","        (empresa_evento, data) in lookup\n","        for data in datas.values()\n","    ):\n","        auditoria.append({\n","            \"empresa_evento\": empresa_evento,\n","            \"data_evento\": data_evento,\n","            \"controles_disponiveis\": 0,\n","            \"controles_selecionados\": 0,\n","            \"status\": \"Excluída: histórico incompleto da empresa com evento\"\n","        })\n","        continue\n","\n","    if any(\n","        lookup[(empresa_evento, datas[lag])][\"LABEL\"] != 0\n","        for lag in [1, 2, 3, 4]\n","    ):\n","        auditoria.append({\n","            \"empresa_evento\": empresa_evento,\n","            \"data_evento\": data_evento,\n","            \"controles_disponiveis\": 0,\n","            \"controles_selecionados\": 0,\n","            \"status\": \"Excluída: LABEL=1 antes do trimestre de referência\"\n","        })\n","        continue\n","\n","    candidatos = []\n","\n","    for controle in empresas:\n","        if controle == empresa_evento:\n","            continue\n","\n","        if not all(\n","            data in datas_empresa[controle]\n","            for data in datas.values()\n","        ):\n","            continue\n","\n","        if not all(\n","            lookup[(controle, datas[lag])][\"LABEL\"] == 0\n","            for lag in range(5)\n","        ):\n","            continue\n","\n","        candidatos.append(controle)\n","\n","    n = min(3, len(candidatos))\n","    selecionados = (\n","        rng.choice(candidatos, size=n, replace=False).tolist()\n","        if n else []\n","    )\n","\n","    episodio = f\"{empresa_evento}_{data_evento:%Y%m%d}\"\n","\n","    # Registrar a empresa com evento\n","    for lag, data in datas.items():\n","        row = lookup[(empresa_evento, data)]\n","        rec = {\n","            \"episodio\": episodio,\n","            \"empresa_referencia\": empresa_evento,\n","            \"ID\": empresa_evento,\n","            \"grupo\": \"Com evento\",\n","            \"data_referencia\": data_evento,\n","            \"lag_trimestres\": lag\n","        }\n","        rec.update({c: row[c] for c in indicadores})\n","        registros.append(rec)\n","\n","    # Registrar controles pareados à data do evento\n","    for controle in selecionados:\n","        for lag, data in datas.items():\n","            row = lookup[(controle, data)]\n","            rec = {\n","                \"episodio\": episodio,\n","                \"empresa_referencia\": empresa_evento,\n","                \"ID\": controle,\n","                \"grupo\": \"Controle\",\n","                \"data_referencia\": data_evento,\n","                \"lag_trimestres\": lag\n","            }\n","            rec.update({c: row[c] for c in indicadores})\n","            registros.append(rec)\n","\n","    auditoria.append({\n","        \"empresa_evento\": empresa_evento,\n","        \"data_evento\": data_evento,\n","        \"controles_disponiveis\": len(candidatos),\n","        \"controles_selecionados\": n,\n","        \"status\": \"OK\" if n > 0 else \"Sem controle elegível\"\n","    })\n","\n","traj = pd.DataFrame(registros)\n","audit = pd.DataFrame(auditoria)\n","\n","if traj.empty:\n","    raise ValueError(\n","        \"Nenhuma trajetória completa foi construída. \"\n","        \"Verifique as datas e os registros da base.\"\n","    )\n","\n","# ============================================================\n","# ETAPA 4 — RESUMO COM CONTAGENS E MEDIANAS\n","# ============================================================\n","nomes_janela = {\n","    4: \"4 trimestres antes\",\n","    3: \"3 trimestres antes\",\n","    2: \"2 trimestres antes\",\n","    1: \"1 trimestre antes\",\n","    0: \"Trimestre do primeiro LABEL=1\"\n","}\n","traj[\"janela\"] = traj[\"lag_trimestres\"].map(nomes_janela)\n","\n","resumos = []\n","for (grupo, lag), parte in traj.groupby([\"grupo\", \"lag_trimestres\"]):\n","    linha = {\n","        \"grupo\": grupo,\n","        \"lag_trimestres\": lag,\n","        \"janela\": nomes_janela[lag],\n","        \"linhas\": len(parte),\n","        \"empresas_unicas\": parte[\"ID\"].nunique(),\n","        \"episodios_unicos\": parte[\"episodio\"].nunique()\n","    }\n","    for c in indicadores:\n","        linha[f\"{c}_mediana\"] = parte[c].median()\n","        linha[f\"{c}_n_observado\"] = parte[c].count()\n","    resumos.append(linha)\n","\n","summary = pd.DataFrame(resumos).sort_values(\n","    [\"grupo\", \"lag_trimestres\"],\n","    ascending=[True, False]\n",")\n","\n","print(\"\\nRESUMO DAS TRAJETÓRIAS\")\n","display(summary)\n","\n","print(\"\\nAUDITORIA DA SELEÇÃO DE CONTROLES\")\n","display(audit[\"status\"].value_counts().rename_axis(\"status\").reset_index(name=\"quantidade\"))\n","\n","# ============================================================\n","# ETAPA 5 — GRÁFICOS\n","# ============================================================\n","ordem_lags = [4, 3, 2, 1, 0]\n","\n","for col in indicadores:\n","    plt.figure(figsize=(9, 4))\n","    for grupo in [\"Com evento\", \"Controle\"]:\n","        parte = traj[traj[\"grupo\"].eq(grupo)]\n","        med = parte.groupby(\"lag_trimestres\")[col].median()\n","        med = med.reindex(ordem_lags)\n","        plt.plot(\n","            [nomes_janela[l] for l in ordem_lags],\n","            med.values,\n","            marker=\"o\",\n","            label=grupo\n","        )\n","    plt.title(f\"Trajetória mediana — {col}\")\n","    plt.ylabel(\"Mediana do indicador\")\n","    plt.xticks(rotation=20, ha=\"right\")\n","    plt.legend()\n","    plt.tight_layout()\n","    plt.show()\n","\n","# ============================================================\n","# ETAPA 6 — SALVAR E BAIXAR UM ZIP COM OS RESULTADOS\n","# ============================================================\n","arquivo_traj = \"trajetorias_balanceadas_evento_controle.csv\"\n","arquivo_resumo = \"resumo_balanceado_evento_controle.csv\"\n","arquivo_auditoria = \"auditoria_controles_balanceados.csv\"\n","arquivo_zip = \"resultados_comparacao_balanceada.zip\"\n","\n","traj.to_csv(arquivo_traj, index=False)\n","summary.to_csv(arquivo_resumo, index=False)\n","audit.to_csv(arquivo_auditoria, index=False)\n","\n","with zipfile.ZipFile(arquivo_zip, \"w\", zipfile.ZIP_DEFLATED)