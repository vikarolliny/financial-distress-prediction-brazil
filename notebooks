_positivas_teste':te.loc[te['TARGET_DISTRESS_12M'].eq(1),'ID'].nunique(),\n","        'ultima_data_treino':str(ultima_data_treino.date()),\n","        'data_limite_horizonte_rotulo_treino':str(ultima_data_alvo_treino.date()),\n","        'primeira_data_teste':str(primeira_data_teste.date()),\n","        'dias_de_folga_apos_horizonte':int((primeira_data_teste - ultima_data_alvo_treino).days),\n","        'horizonte_treino_nao_alcanca_teste':bool(ultima_data_alvo_treino < primeira_data_teste),\n","        'mesmas_empresas_podem_aparecer_nos_dois':bool(set(tr['ID']) & set(te['ID'])),\n","    })\n","audit_folds=pd.DataFrame(linhas_auditoria)\n","print('AUDITORIA DE VAZAMENTO ENTRE OS CORTES TEMPORAIS')\n","display(audit_folds)\n","if not audit_folds['horizonte_treino_nao_alcanca_teste'].all():\n","    print('ATENÇÃO: existe sobreposição potencial do horizonte do alvo.')\n","else:\n","    print('Nenhum horizonte de 365 dias de um exemplo de TREINO alcança as datas de TESTE desses folds.')\n","print('Isto não prova ausência de vazamento pela data real de publicação das demonstrações,')\n","print('nem permite inferir como o autor original construiu LABEL.')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":339},"id":"bv2jTLv4aAKA","executionInfo":{"status":"ok","timestamp":1792971127968,"user_tz":180,"elapsed":90,"user":{"displayName":"Vitória Karolliny","userId":"04902831398934237780"}},"outputId":"4fb8eea0-d0bb-478e-f0be-f8a1627802af"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["AUDITORIA DE VAZAMENTO ENTRE OS CORTES TEMPORAIS\n"]},{"output_type":"display_data","data":{"text/plain":["              fold  linhas_treino  positivos_treino  linhas_teste  \\\n","0  Teste 2017–2018          11371                52          4273   \n","1  Teste 2019–2020          15737                65          4495   \n","2  Teste 2022–2023          22334                96          2521   \n","\n","   positivos_teste  empresas_positivas