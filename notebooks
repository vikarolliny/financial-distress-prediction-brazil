ID\"], errors=\"raise\").astype(int)\n","df[\"QUARTER\"] = pd.to_datetime(df[\"QUARTER\"], errors=\"raise\")\n","df[\"LABEL\"] = pd.to_numeric(df[\"LABEL\"], errors=\"raise\").astype(int)\n","indicators = [c for c in df.columns if c.startswith(\"A\") and c[1:].isdigit()]\n","if len(indicators) != 84:\n","    raise ValueError(f\"Esperados 84 indicadores; encontrados {len(indicators)}\")\n","if not df[\"LABEL\"].isin([0, 1]).all():\n","    raise ValueError(\"LABEL contém valor diferente de 0 e 1.\")\n","if df.duplicated([\"ID\", \"QUARTER\"]).any():\n","    raise ValueError(\"Ainda existem duplicatas na chave ID + QUARTER.\")\n","\n","df = df.sort_values([\"ID\", \"QUARTER\"]).reset_index(drop=True)\n","transitions_10 = 0\n","transitions_01 = 0\n","first_event_by_id = {}\n","for id_, g in df.groupby(\"ID\", sort=False):\n","    y = g[\"LABEL\"].to_numpy()\n","    transitions_01 += int(np.sum((y[:-1] == 0) & (y[1:] == 1)))\n","    transitions_10 += int(np.sum((y[:-1] == 1) & (y[1:] == 0)))\n","    ev = g.loc[g[\"LABEL\"] == 1, \"QUARTER\"]\n","    if len(ev):\n","        first_event_by_id[id_] = ev.iloc[0]\n","\n","print(f\"Linhas: {len(df):,} | empresas: {df['ID'].nunique():,} | indicadores: {len(indicators)}\")\n","print(f\"Transições 0→1 observadas: {transitions_01}\")\n","print(f\"Transições 1→0 observadas: {transitions_10}\")\n","if transitions_10:\n","    print(\"ATENÇÃO: há empresas que voltam de LABEL=1 para LABEL=0. A regra de primeira ocorrência deve ser revisada antes de usar o alvo.\")\n","else:\n","    print(\"Não foram observadas transições 1→0 nesta base limpa.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"7EjiPDKtyfQY","executionInfo":{"status":"ok","timestamp":1792944139309,"user_tz":180,"elapsed":568,"user":{"displayName":"Vitória Karolliny","userId":"04902831398934237780"}},"outputId":"04b1bdbb-e318-431f-a686-9aba6b20562c"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Linhas: 31,999 | empr