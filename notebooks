xistem datas inválidas em {nome}.')\n","\n","modelagem['TARGET_DISTRESS_12M'] = pd.to_numeric(modelagem['TARGET_DISTRESS_12M'], errors='raise').astype(int)\n","primeiro_evento = (\n","    painel.loc[painel['LABEL'].eq(1)]\n","    .groupby('ID')['QUARTER'].min()\n","    .rename('primeiro_LABEL_1')\n",")\n","if modelagem.duplicated(['ID', 'QUARTER']).any():\n","    raise ValueError('Há linhas duplicadas por empresa e trimestre na modelagem.')\n","\n","positivos = modelagem.loc[modelagem['TARGET_DISTRESS_12M'].eq(1), ['ID', 'QUARTER']].copy()\n","positivos = positivos.join(primeiro_evento, on='ID')\n","positivos['dias_entre_trimestre_e_evento'] = (\n","    positivos['primeiro_LABEL_1'] - positivos['QUARTER']\n",").dt.days\n","\n","if positivos['primeiro_LABEL_1'].isna().any():\n","    raise ValueError('Há alvos positivos sem evento correspondente no painel.')\n","if not positivos['dias_entre_trimestre_e_evento'].between(1, 365).all():\n","    raise ValueError('Há alvos positivos fora do horizonte de 1 a 365 dias.')\n","\n","print('CONFERÊNCIA INICIAL')\n","print('Linhas na base de modelagem:', len(modelagem))\n","print('Alvos positivos:', len(positivos))\n","print('Empresas com alvo positivo:', positivos['ID'].nunique())\n","print('Empresas com LABEL=1 no painel:', len(primeiro_evento))\n","print('Registros positivos com intervalo mínimo:', positivos['dias_entre_trimestre_e_evento'].min(), 'dias')\n","print('Registros positivos com intervalo máximo:', positivos['dias_entre_trimestre_e_evento'].max(), 'dias')\n","print('\\nDistribuição das antecedências (dias):')\n","display(positivos['dias_entre_trimestre_e_evento'].describe(percentiles=[.1, .25, .5, .75, .9]).to_frame())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":523},"id":"PPHte0z5bngf","executionInfo":{"status":"ok","timestamp":1792971721164,"user_tz":180,"elapsed":73,"user":{"displayName":"Vitória Karolliny","userId":"04902831398934237780"}},"outputId":"6acbb35a-b55c-416b-8a49-2a837dba2fe5