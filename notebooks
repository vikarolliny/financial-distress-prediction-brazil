        continue\n","    X_train, y_train = train[features], train[\"TARGET_DISTRESS_12M\"].astype(int)\n","    X_test, y_test = test[features], test[\"TARGET_DISTRESS_12M\"].astype(int)\n","    for model_name, model in make_models().items():\n","        model.fit(X_train, y_train)\n","        scores = model.predict_proba(X_test)[:, 1]\n","        ap = average_precision_score(y_test, scores)\n","        try:\n","            auc = roc_auc_score(y_test, scores)\n","        except ValueError:\n","            auc = np.nan\n","        fold_metrics.append({\n","            \"fold\":f[\"fold\"], \"modelo\":model_name, \"linhas_teste\":len(test),\n","            \"positivos_teste\":int(y_test.sum()), \"empresas_positivas_teste\":test.loc[y_test.eq(1),\"ID\"].nunique(),\n","            \"prevalencia_teste\":y_test.mean(), \"PR_AUC\":ap, \"ROC_AUC\":auc\n","        })\n","        temp = test[[\"ID\",\"QUARTER\",\"TARGET_DISTRESS_12M\"]].copy()\n","        temp[\"fold\"] = f[\"fold\"]\n","        temp[\"modelo\"] = model_name\n","        temp[\"score\"] = scores\n","        predictions.append(temp)\n","\n","metrics_df = pd.DataFrame(fold_metrics)\n","pred_df = pd.concat(predictions, ignore_index=True) if predictions else pd.DataFrame()\n","display(metrics_df.sort_values([\"fold\",\"PR_AUC\"], ascending=[True,False]))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":238},"id":"dxRYI0X_vlfm","executionInfo":{"status":"ok","timestamp":1792960176732,"user_tz":180,"elapsed":55260,"user":{"displayName":"Vitória Karolliny","userId":"04902831398934237780"}},"outputId":"8cec309d-030b-4331-8bdd-dd81f0101311"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["              fold               modelo  linhas_teste  positivos_teste  \\\n","1  Teste 2017–2018        Random Forest          4273               20   \n","0  Teste 2017–2018  Regressão logística          4273               20   \n","3  Teste 2019–2020        Random Forest 