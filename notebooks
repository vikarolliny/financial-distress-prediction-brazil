ao_aleatoria_linhas\": y_arr.mean()\n","        })\n","    return rows\n","\n","topk_rows = []\n","for model_name, key in [\n","    (\"Regressão logística\", \"Regressão logística\"),\n","    (\"Random Forest\", \"Random Forest\")\n","]:\n","    topk_rows.extend(top_k_table(y_test, test_df[\"ID\"], scores[key], model_name))\n","topk_df = pd.DataFrame(topk_rows)\n","display(topk_df.style.format({\n","    \"percentual_revisado\": \"{:.0%}\",\n","    \"precisao_linhas\": \"{:.2%}\",\n","    \"recall_linhas\": \"{:.2%}\",\n","    \"recall_empresas_positivas\": \"{:.2%}\",\n","    \"precisao_aleatoria_linhas\": \"{:.2%}\"\n","}))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":362},"id":"BwgvYRnx5-L8","executionInfo":{"status":"ok","timestamp":1792946264188,"user_tz":180,"elapsed":25,"user":{"displayName":"Vitória Karolliny","userId":"04902831398934237780"}},"outputId":"54a896ed-c634-45ef-92ce-478c18188379"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<pandas.io.formats.style.Styler at 0x79e8e8424a50>"],"text/html":["<style type=\"text/css\">\n","</style>\n","<table id=\"T_c1e41\" class=\"dataframe\">\n","  <thead>\n","    <tr>\n","      <th class=\"blank level0\" >&nbsp;</th>\n","      <th id=\"T_c1e41_level0_col0\" class=\"col_heading level0 col0\" >modelo</th>\n","      <th id=\"T_c1e41_level0_col1\" class=\"col_heading level0 col1\" >percentual_revisado</th>\n","      <th id=\"T_c1e41_level0_col2\" class=\"col_heading level0 col2\" >linhas_alertadas</th>\n","      <th id=\"T_c1e41_level0_col3\" class=\"col_heading level0 col3\" >positivos_capturados_linhas</th>\n","      <th id=\"T_c1e41_level0_col4\" class=\"col_heading level0 col4\" >precisao_linhas</th>\n","      <th id=\"T_c1e41_level0_col5\" class=\"col_heading level0 col5\" >recall_linhas</th>\n","      <th id=\"T_c1e41_level0_col6\" class=\"col_heading level0 col6\" >empresas_unicas_na_lista</th>\n","      <th id=\"T_c1e41_level0_col7\" class=\"